<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Plain platform theme: this app is 100% Compose, so no AppCompat/Material
      view-layer dependency is needed (keeps the APK small and the build simple).
    -->
    <style name="Theme.CloudMusicTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
